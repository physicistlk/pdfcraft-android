+        assert_eq!(recorder.take(), vec![
+            "enable",
+            "content_type:Normal",
+            "cursor:1,2,3,4",
+            "text_change_cause:Other",
+            "surrounding:abc:1:1",
+            "commit",
+        ]);
+        assert_eq!(data.incoming_from, Some(serial));
+        assert!(data.accepts_incoming());
