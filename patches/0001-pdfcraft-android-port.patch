+        };
+        let first_recorder = make_recorder();
+        let second_recorder = make_recorder();
+        let (resets, fence) = reset_inputs_with_fence(
+            &[(&first_recorder, Some(&first)), (&second_recorder, Some(&second))],
+            &state(None, None),
