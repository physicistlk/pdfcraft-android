+            ImePurpose::Normal,
+            Some((9, 8, 7, 6)),
+            first.surrounding_text.clone(),
+        );
+        assert!(matches!(data.sync_outgoing(&recorder, &cursor, None), OutgoingCommit::Sent(_)));
+        assert_eq!(
+            recorder.take(),
+            vec![
+                "content_type:Normal",
+                "cursor:9,8,7,6",
+                "text_change_cause:Other",
+                "surrounding:abc:3:3",
+                "commit",
