+
+impl<K: Clone + PartialEq> ImePreeditOwnership<K> {
+    pub(crate) fn claim(&mut self, key: &K) {
+        self.owner = Some(key.clone());
+    }
+
+    pub(crate) fn release(&mut self, key: &K) -> bool {
+        if self.owner.as_ref() == Some(key) {
+            self.owner = None;
+            true
+        } else {
+            false
