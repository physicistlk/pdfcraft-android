+        assert!(resets.iter().all(|(_, sequence)| *sequence < fence));
+        assert!(first.try_lock().is_ok() && second.try_lock().is_ok());
+        let (_, empty_fence) = reset_inputs_with_fence::<Recorder>(&[], &state(None, None));
+        assert!(fence < empty_fence);
+    }
