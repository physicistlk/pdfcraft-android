+/// Install the Android shell's clipboard reader (called once, before the window opens).
+#[cfg(target_os = "android")]
+pub fn install_clipboard_text(reader: fn() -> Option<String>) {
+    if let Ok(mut slot) = CLIPBOARD_TEXT.lock() {
+        *slot = Some(reader);
+    }
+}
