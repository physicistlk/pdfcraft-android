+            let delivered = deliveries(&mut sink);
+            assert_eq!(delivered.len(), 3);
+            assert_eq!(
+                delivered
+                    .iter()
+                    .filter(|(_, event, deletion)| matches!(event, Ime::Commit(_))
+                        && *deletion == Some(delete))
+                    .count(),
+                1
+            );
