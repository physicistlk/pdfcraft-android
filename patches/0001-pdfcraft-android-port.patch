+        input.set_cursor_rectangle(x, y, width, height);
+    }
+    if let Some((text, cursor, anchor)) = &state.surrounding_text {
+        input.set_text_change_cause(change_cause);
+        input.set_surrounding_text(text.clone(), *cursor, *anchor);
+    }
